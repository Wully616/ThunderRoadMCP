<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ThunderRoadMcp.Compiler</AssemblyName>
    <RootNamespace>ThunderRoadMcp.Compiler</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ThunderRoad"><HintPath>$(GameManagedDir)\ThunderRoad.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
